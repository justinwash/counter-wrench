     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/IntakeForm"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/intakes/{intake_id}/continue": {
   "post": {
    "tags": [
     "intakes"
    ],
    "summary": "Continue To Draft",
    "description": "Counter staff are done with the triage: draft the work order for the mechanic.",
    "operationId": "continue_to_draft_api_intakes__intake_id__continue_post",
    "parameters": [
     {
      "name": "intake_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Intake Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/intakes/{intake_id}/revise": {
   "post": {
    "tags": [
     "intakes"
    ],
    "summary": "Revise",
    "description": "Answer the questions or fix the notes, then triage again. The paused run is finished\nas `revised` first, so its trace ends cleanly instead of hanging at the pause.",
    "operationId": "revise_api_intakes__intake_id__revise_post",
    "parameters": [
     {
      "name": "intake_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Intake Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Revision"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/intakes/{intake_id}/decline": {
   "post": {
    "tags": [
     "intakes"
    ],
    "summary": "Decline",
    "description": "The customer doesn't want the work: keep a declined record and release the bike. A\nsafety-critical decline needs a signed waiver (the database enforces it too).",
    "operationId": "decline_api_intakes__intake_id__decline_post",
    "parameters": [
     {
      "name": "intake_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Intake Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Decline"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/intakes/{intake_id}/answers": {
   "post": {
    "tags": [
     "intakes"
    ],
    "summary": "Answer",
    "description": "The bike couldn't be resolved, so the run stopped: re-run with the bike staff picked,\nor with the bike marked unconfirmed (labor only; the mechanic identifies it).",
    "operationId": "answer_api_intakes__intake_id__answers_post",
    "parameters": [
     {
      "name": "intake_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Intake Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Answers"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/orders": {
   "get": {
    "tags": [
     "orders"
    ],
    "summary": "Orders",
    "description": "The review queue is `status=awaiting_review`: safety-critical first, then newest.",
    "operationId": "orders_api_orders_get",
    "parameters": [
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Status"
      }
     },
     {
      "name": "include_eval",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false,
       "title": "Include Eval"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/OrderSummary"
         },
         "title": "Response Orders Api Orders Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/orders/{order_id}": {
   "get": {
    "tags": [
     "orders"
    ],
    "summary": "Order",
    "operationId": "order_api_orders__order_id__get",
    "parameters": [
     {
      "name": "order_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Order Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OrderDetail"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/orders/{order_id}/part-options": {
   "get": {
    "tags": [
     "orders"
    ],
    "summary": "Part Options",
    "description": "Parts of a category for the order's bike, split into compatible and unverified, for\nthe mechanic adding a line. Orders without a catalog bike have no parts to offer.",
    "operationId": "part_options_api_orders__order_id__part_options_get",
    "parameters": [
     {
      "name": "order_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Order Id"
      }
     },
     {
      "name": "category",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Category"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CompatiblePartsResult"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/orders/{order_id}/lines": {
   "put": {
    "tags": [
     "orders"
    ],
    "summary": "Edit",
    "description": "Replace the lines of a draft awaiting review, checked like the agent's own drafts.",
    "operationId": "edit_api_orders__order_id__lines_put",
    "parameters": [
     {
      "name": "order_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Order Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/EditLinesArgs"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OrderDetail"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/orders/{order_id}/rating": {
   "post": {
    "tags": [
     "orders"
    ],
    "summary": "Rate",
    "description": "Thumbs up or down on the agent's work. One vote per person per order; sending another\nreplaces it. See online/ratings.py for what a vote does in LangSmith.",
    "operationId": "rate_api_orders__order_id__rating_post",
    "parameters": [
     {
      "name": "order_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Order Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/RatingRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Rating"
         },
         "title": "Response Rate Api Orders  Order Id  Rating Post"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/orders/{order_id}/review": {
   "post": {
    "tags": [
     "orders"
    ],
    "summary": "Review",
    "operationId": "review_api_orders__order_id__review_post",
    "parameters": [
     {
      "name": "order_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Order Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ReviewDecision"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ReviewResult"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Answers": {
    "properties": {
     "bike_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Bike Id",
      "description": "The catalog bike, once identified."
     },
     "bike_unconfirmed": {
      "type": "boolean",
      "title": "Bike Unconfirmed",
      "description": "The customer doesn't know either: carry on without a catalog bike.",
      "default": false
     }
    },
    "type": "object",
    "title": "Answers"
   },
   "BikeCandidate": {
    "properties": {
     "bike_id": {
      "type": "string",
      "title": "Bike Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     }
    },
    "type": "object",
    "required": [
     "bike_id",
     "name"
    ],
    "title": "BikeCandidate"
   },
   "CompatiblePartsResult": {
    "properties": {
     "bike_id": {
      "type": "string",
      "title": "Bike Id"
     },
     "category": {
      "type": "string",
      "title": "Category"
     },
     "compatible": {
      "items": {
       "$ref": "#/components/schemas/PartFit"
      },
      "type": "array",
      "title": "Compatible",
      "default": []
     },
     "unverified": {
      "items": {
       "$ref": "#/components/schemas/PartFit"
      },
      "type": "array",
      "title": "Unverified",
      "default": []
     },
     "unverified_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Unverified Note"
     },
     "omitted_incompatible": {
      "type": "integer",
      "title": "Omitted Incompatible",
      "default": 0
     },
     "omitted_reasons": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Omitted Reasons",
      "default": []
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     }
    },
    "type": "object",
    "required": [
     "bike_id",
     "category"
    ],
    "title": "CompatiblePartsResult"
   },
   "Complaint": {
    "type": "string",
    "enum": [
     "squeak",
     "creak",
     "click",
     "poor_shifting",
     "skipping",
     "chain_drop",
     "brake_rub",
     "brake_noise",
     "soft_brake_lever",
     "weak_braking",
     "wobble",
     "flat_tire",
     "slow_leak",
     "suspension_packing_up",
     "suspension_bouncing",
     "suspension_bottoming",
     "suspension_harsh",
     "suspension_sticky",
     "suspension_leaking",
     "suspension_knock",
     "dropper_issue",
     "other"
    ],
    "title": "Complaint"
   },
   "ComplaintOption": {
    "properties": {
     "value": {
      "type": "string",
      "title": "Value"
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "areas": {
      "items": {
       "$ref": "#/components/schemas/Option"
      },
      "type": "array",
      "title": "Areas"
     }
    },
    "type": "object",
    "required": [
     "value",
     "label",
     "areas"
    ],
    "title": "ComplaintOption"
   },
   "ComplaintRow": {
    "properties": {
     "row_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,20}$",
      "title": "Row Id"
     },
     "complaint": {
      "$ref": "#/components/schemas/Complaint"
     },
     "suspected_area": {
      "$ref": "#/components/schemas/SuspectedArea"
     },
     "note": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500,
        "minLength": 1
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "row_id",
     "complaint",
     "suspected_area"
    ],
    "title": "ComplaintRow"
   },
   "Decline": {
    "properties": {
     "staff": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "title": "Staff"
     },
     "waiver_signed": {
      "type": "boolean",
      "title": "Waiver Signed",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "staff"
    ],
    "title": "Decline"
   },
   "EditLinesArgs": {
    "properties": {
     "editor": {
      "type": "string",
      "minLength": 1,
      "title": "Editor"
     },
     "labor_lines": {
      "items": {
       "$ref": "#/components/schemas/LaborRequest"
      },
      "type": "array",
      "title": "Labor Lines"
     },
     "part_lines": {
      "items": {
       "$ref": "#/components/schemas/PartRequest"
      },
      "type": "array",
      "title": "Part Lines"
     }
    },
    "type": "object",
    "required": [
     "editor"
    ],
    "title": "EditLinesArgs",
    "description": "A mechanic's replacement lines for a draft awaiting review."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IntakeForm": {
    "properties": {
     "bike_id": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Bike Id"
     },
     "bike_freetext": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500,
        "minLength": 1
       },
       {
        "type": "null"
       }
      ],
      "title": "Bike Freetext"
     },
     "rows": {
      "items": {
       "$ref": "#/components/schemas/ComplaintRow"
      },
      "type": "array",
      "maxItems": 10,
      "minItems": 1,
      "title": "Rows"
     },
     "general_notes": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000,
        "minLength": 1
       },
       {
        "type": "null"
       }
      ],
      "title": "General Notes"
     },
     "answers": {
      "patternProperties": {
       "^[A-Za-z0-9_-]{1,20}$": {
        "type": "string",
        "maxLength": 4000,
        "minLength": 1
       }
      },
      "type": "object",
      "title": "Answers"
     },
     "question_rounds": {
      "patternProperties": {
       "^[A-Za-z0-9_-]{1,20}$": {
        "type": "integer"
       }
      },
      "type": "object",
      "title": "Question Rounds"
     },
     "bike_unconfirmed": {
      "type": "boolean",
      "title": "Bike Unconfirmed",
      "default": false
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "rows"
    ],
    "title": "IntakeForm"
   },
   "LaborOption": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "price_cents": {
      "type": "integer",
      "title": "Price Cents"
     },
     "category": {
      "type": "string",
      "title": "Category"
     }
    },
    "type": "object",
    "required": [
     "code",
     "name",
     "price_cents",
     "category"
    ],
    "title": "LaborOption"
   },
   "LaborRequest": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code",
      "description": "Service menu code from get_labor_item or search_labor_menu."
     },
     "qty": {
      "type": "integer",
      "maximum": 10.0,
      "minimum": 1.0,
      "title": "Qty",
      "description": "Units, e.g. 2 for both brakes.",
