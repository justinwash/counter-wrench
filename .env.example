# Copy to .env and fill in what you have. Never commit .env.

# --- LLM providers -----------------------------------------------------------
# Any one key is enough to run the agent. When the model settings below are
# blank, the first key found in this order picks the defaults:
# Anthropic -> OpenAI -> Google -> OpenRouter.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Models per role -----------------------------------------------------------
# Format: provider:model (e.g. anthropic:<model>, openai:<model>,
# google_genai:<model>). Leave blank to auto-detect from the keys above.
AGENT_MODEL=
TRIAGE_MODEL=
# The judge should be a different model family than the agent when possible.
JUDGE_MODEL=

# Official eval config (the numbers in the README), via one OpenRouter key:
# AGENT_MODEL=openrouter:anthropic/claude-haiku-5.5
# TRIAGE_MODEL=openrouter:anthropic/claude-haiku-5.5
# JUDGE_MODEL=openrouter:openai/gpt-6.1-sol
# OPENROUTER_PROVIDER_ORDER=anthropic,openai

# Comma-separated OpenRouter backends to use, in order, with fallbacks disabled.
# Without it, the same model ID can be served by different backends between runs.
OPENROUTER_PROVIDER_ORDER=

# --- LangSmith -------------------------------------------------------------------
# Optional for running the agent; required for evals. Tracing is on when the key is set.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=counterwrench-dev
